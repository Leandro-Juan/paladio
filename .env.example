# ==============================================================================
# Paladio - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to fit your deployment environment.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# --- Database & Persistence (PostgreSQL + TimescaleDB + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paladio
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/paladio

# --- Redis & Cache / Message Broker ---
REDIS_URL=redis://redis:6379/0

# --- Authentication & Security ---
# Secret key used for signing JWT tokens. Set a secure 256-bit string in production!
JWT_SECRET_KEY=paladio-sovereign-travel-secret-key-development-mode-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
ALLOW_PUBLIC_REGISTRATION=false

# --- Sovereign LLM & Embeddings (Ollama Stack) ---
# Internal Docker service URL is http://llm:11434; localhost host port is 11435
OLLAMA_BASE_URL=http://llm:11434
OLLAMA_HOST=http://llm:11434
VALIDATOR_MODEL=ollama:qwen2.5
TICKET_PARSER_MODEL=ollama:qwen2.5
RAG_MODEL=ollama:qwen2.5
TRANSIT_PARSER_MODEL=qwen2.5:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Geospatial Routing Engine (Valhalla OSM) ---
VALHALLA_URL=http://valhalla:8002

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream
NEXT_PUBLIC_WS_PORT=8000
