# ==============================================================================
# Paladio - Self-Hosted Bootstrap Configuration (.env.example)
# ==============================================================================
# Copy this file to .env to customize root credentials:
#   cp .env.example .env
#   docker compose up -d
#
# NOTE: All application integrations (LLM providers, Aviasales tokens,
# Immich/Synology vaults, push notification webhooks, and solver pacing)
# are configured dynamically in the web UI at http://localhost:3000/config.
# This file is strictly for root infrastructure credentials and cryptographic keys.
# ==============================================================================

# --- Database Root Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=paladio

# --- Security & Authentication Root Keys ---
# Secret key used for signing JWT tokens. Set a secure 256-bit string in production!
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_in_production
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Optional Host Port Overrides (Only needed if conflicting on the host) ---
# API_PORT=8000
# FRONTEND_PORT=3000
