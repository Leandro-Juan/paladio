# ==============================================================================
# Paladio - Self-Hosted Bootstrap Configuration (.env.example)
# ==============================================================================
# Copy this file to .env to customize credentials and ports:
#   cp .env.example .env
#   docker compose up -d
#
# NOTE: Application integrations (LLM providers, Aviasales tokens,
# Immich/Synology vaults, push notification webhooks, and solver pacing)
# are configured dynamically in the web UI at http://localhost:3000/config.
# ==============================================================================

# --- Database Root Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=paladio

# --- Security & Authentication Root Keys ---
# HS256 JWT signing secret (auto-generated into /data/.jwt_secret if omitted).
# Generate one manually with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_in_production

# Fernet symmetric key for Bookings Wallet secrets (auto-generated into /data/.wallet_key if omitted).
# Generate one manually with: openssl rand 32 | openssl base64 -A | tr '+/' '-_'
# WALLET_ENCRYPTION_KEY=

ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_WORKERS=1

# --- Optional Host Ports, Public URL, Image Version & Map Seed ---
# API_PORT=8000
# FRONTEND_PORT=3000
# ALLOWED_ORIGINS=
# PALADIO_PUBLIC_API_URL=
# PALADIO_VERSION=latest
# VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
