# ==============================================================================
# Paladio - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to fit your deployment environment.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# --- Database & Persistence (PostgreSQL + TimescaleDB + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paladio
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/paladio

# --- Redis & Cache / Message Broker ---
REDIS_URL=redis://redis:6379/0

# --- Authentication & Security ---
# Secret key used for signing JWT tokens. Set a secure 256-bit string in production!
JWT_SECRET_KEY=paladio-sovereign-travel-secret-key-development-mode-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
ALLOW_PUBLIC_REGISTRATION=false

# --- Embeddings Engine (In-Process CPU ONNX / FastEmbed) ---
FASTEMBED_CACHE_PATH=/opt/models/fastembed
FASTEMBED_THREADS=2

# --- Chat Agent LLM Configuration (Optional; for TripAgentRunner only) ---
# Set LLM_PROVIDER / LLM_MODEL / LLM_API_KEY (or provider-specific keys) if using the interactive chat agent.

# --- Geospatial Routing Engine (Valhalla OSM) ---
VALHALLA_URL=http://valhalla:8002

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream
NEXT_PUBLIC_WS_PORT=8000

# --- Market & Flight Deal Engine ---
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
AVIASALES_MARKET=es
AVIASALES_CURRENCY=EUR
AVIASALES_MAX_RPM=60
MARKET_DAILY_TOP_N=3
