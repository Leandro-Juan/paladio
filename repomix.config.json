{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 10
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "package-lock.json",
      "pnpm-lock.yaml",
      "poetry.lock",
      "skills-lock.json",
      "frontend/public/data/**",
      "**/*.geo.json",
      "backend/tests/test_data.json",
      "backend/tests/output/**",
      "cpp_core/tests/cpp/real_pois_data.hpp",
      "comprehensive_audit_report.md",
      "site/**",
      "scratch/**",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map"
    ]
  }
}
